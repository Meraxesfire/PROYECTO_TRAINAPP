# Copiar a .env.local y rellenar con valores reales.
# NUNCA incluir valores reales en este archivo ni commitear .env.local.

# Público: cliente Supabase (RLS protege los datos)
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# Secreto: solo scripts locales/admin. NO usar en código de navegador.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# Público: base para los redirects de Supabase Auth
NEXT_PUBLIC_SITE_URL=http://localhost:3000
